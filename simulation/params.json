        "保本",
        "一定能",
        "稳赢",
        "收益承诺",
        "风险淡化",
        "诱导交易",
        "绝对收益",
        "零风险",
        "保证收益"
      ]
    }
  },
  "simulation": {
    "n_users": 200,
    "n_periods": 4,
    "__design_target_DO_NOT_USE": "设计初期方向假设，非验收指标；一切以 simulate.py 实际输出为准"
  },
  "sensitivity": {
    "initial_step_grid": [
      0.02,
      0.05,
      0.08,
      0.12
    ],
    "decay_grid": [
      0.8,
      0.85,
      0.9,
      0.95
    ]
  }
