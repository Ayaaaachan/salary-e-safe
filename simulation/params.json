      "sigma_threshold": 3.0,
      "iqr_multiplier": 1.5
    },
    "fill_strategy": {
      "balance": "ffill",
      "amount": "zero_for_missing_days"
    }
  },
  "features": {
    "lookback_periods": 3,
    "quantiles": [
      0.1,
      0.5,
      0.9
    ]
  },
  "model": {
    "predict": {
      "method": "lightgbm_quantile",
      "lookback_periods": 3,
      "quantiles": [
        0.1,
        0.5,
        0.9
      ],
      "naive_baseline": "last_period_same_day_mean",
      "test_size": 0.3
