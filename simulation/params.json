{
  "__note": "工银薪e安 仿真项目唯一参数源。所有脚本从本文件读取参数，禁止在代码中硬编码。合成数据回放，非精度承诺。",
  "random_seed": 20260926,
  "data": {
    "n_users": 200,
    "n_months": 12,
    "start_date": "2025-01-01",
    "salary": {
      "min": 4000,
      "max": 15000,
      "distribution": "lognormal",
      "mu": 8.9,
      "sigma": 0.35
    },
    "payday_options": [
      5,
      10,
      15,
      20
    ],
    "rent": {
      "ratio_min": 0.25,
      "ratio_max": 0.4,
      "center": 0.3333,
      "sigma": 0.04
    },
    "credit_repayment": {
      "min_count": 1,
      "max_count": 2,
      "ratio_min": 0.05,
      "ratio_max": 0.15
    },
    "spending_effects": {
      "post_payday_peak_days": 3,
      "post_payday_multiplier": 2.2,
      "weekend_multiplier": 1.5,
      "month_end_contraction": 0.45,
      "month_end_days": 5
    },
    "large_expense": {
      "prob_per_month": 0.12,
      "amount_min_ratio": 0.3,
      "amount_max_ratio": 1.2
    },
    "festivals": {
      "spring_festival": {
        "month": 2,
        "day": 10,
        "multiplier": 2.5,
        "window_days": 7
      },
      "national_day": {
        "month": 10,
        "day": 1,
        "multiplier": 2.0,
        "window_days": 7
      }
    },
    "rigid_offset_days": 3,
    "daily_spending_base_ratio": 0.0071,
    "initial_balance_months": 1.5
