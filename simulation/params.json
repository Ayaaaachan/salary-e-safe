    "calibrate": {
      "initial_step": 0.05,
      "decay": 0.9,
      "asymmetric": {
        "up_speed": 1.0,
        "down_speed": 0.3
      },
      "alpha_init": 0.85,
      "unfreeze_threshold_ratio": 0.0
    },
    "guard": {
      "blacklist": [
